		CA	ZERO
		TS	TIMECTR		# TIME COUNTER STARTS AT 0
		TS	PWRLEVEL	# init PWRLEVEL with zero power
		TS	SPEED		# reset speed
		TS	ONSURFAC
		TS	STARTED
		TS	FINISHED
		TS	DIGIT1
		TS	DIGIT2
		TS	DIGIT3
		TS	DIGIT4
