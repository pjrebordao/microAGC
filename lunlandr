# LUNLANDR

# Definitions of various registers.
ARUPT       	EQUALS    10
QRUPT       	EQUALS    12
TIME3       	EQUALS    26
TIME4       	EQUALS    27
TIME5		EQUALS    30
NEWJOB      	EQUALS    67    # Location checked by the Night Watchman.			

# VARIABLES
		SETLOC	68
KEYBUF      	ERASE           # 040 when empty, 0-037 when holding a code
DIGIT1		ERASE
DIGIT2		ERASE
DIGIT3		ERASE
DIGIT4		ERASE
DIGIT5		ERASE
DIGIT5BK	ERASE		# backup of digit5 used for register_y
SUBJECT		ERASE		# integer (input) to convert to 5 digits
PWRLEVEL	ERASE		# power setting entered from DSKY (0-9)
TMPBUF1		ERASE		# buffer1
ACCEL		ERASE
SPEED		ERASE		# current speed
HEIGHT		ERASE		# current height
FUEL		ERASE
TIMECTR		ERASE		# elapsed time counter
ONSURFAC	ERASE		# flag indicating landing - good or bad
COUNTER		ERASE
STARTED		ERASE
FINISHED	ERASE
DSKYPHAS	ERASE
TMPBUF2		ERASE		# buffer2
TMPBUF3		ERASE		# buffer3
RESET		ERASE
TGTACCEL	ERASE

# STORAGE FOR CONSTANTS
ZERO        	ERASE	
ONE		ERASE	
TWO         	ERASE	
MAXSPD		ERASE	
MIDPWR		ERASE	
TH1		ERASE	
TH10		ERASE	
HUNDRED		ERASE	
TEN		ERASE	
FIFTEEN		ERASE	
SIXTEEN		ERASE	
THIRTY		ERASE	
ENTERKEY	ERASE	
RESETKEY	ERASE	

# code starts here
		SETLOC    4000  # The interrupt-vector table.

# Come here at power-up or GOJAM

		INHINT                # Disable interrupts for a moment.
		
# Set up the TIME3 interrupt, T3RUPT.  TIME3 is a 15-bit
# register at address 026, which automatically increments every
# 10 ms, and a T3RUPT interrupt occurs when the timer
# overflows.  Thus if it is initially loaded with 037774,
# and overflows when it hits 040000, then it will
# interrupt after 40 ms.

		CA        O37774
		TS        TIME3
		TCF       STARTUP    # Go to your "real" code.
		
		RESUME 	# T6RUPT
		NOOP
		NOOP
		NOOP

		DXCH      ARUPT       # T5RUPT
		EXTEND                # Back up A, L, and Q registers
		QXCH      QRUPT
		TCF       T5RUPT

		DXCH      ARUPT       # T3RUPT
		EXTEND                # Back up A, L, and Q registers
		QXCH      QRUPT
		TCF       T3RUPT

		DXCH	  ARUPT	      # T4RUPT
		EXTEND                # Back up A, L, and Q registers
		QXCH      QRUPT
		TCF       T4RUPT

		DXCH      ARUPT       # KEYRUPT1
		EXTEND                # Back up A, L, and Q registers
		QXCH      QRUPT
		TCF       KEYRUPT1
			
		RESUME    # KEYRUPT2
		NOOP
		NOOP
		NOOP

		RESUME    # UPRUPT
		NOOP
		NOOP
		NOOP

		RESUME    # DOWNRUPT
		NOOP
		NOOP
		NOOP

		RESUME    # RADAR RUPT
		NOOP
		NOOP
		NOOP

		RESUME    # RUPT10
		NOOP
		NOOP				
		NOOP

	
# The interrupt-service routine for the TIME3 interrupt every 40 ms. 

T3RUPT      	CAF     O37774      # Schedule another TIME3 interrupt in 40 ms.
		TS      TIME3

		CS      NEWJOB

		DXCH    ARUPT       # Restore A, L, and Q, and exit the interrupt
		EXTEND
		QXCH    QRUPT
		RESUME       
#
# DSKY SERVICING
#
# THIS IS A LENGTHY ROUTINE SO IS SPLIT INTO 2 PHASES / PASSES
#
T4RUPT		CAF	DSKYUPDA	# SERVICES THE DSKY 
		TS	TIME4	
		CA	STARTED
		EXTEND
		BZF	FINIS2		# NOT STARTED - NO NEED TO UPDATE DSKY	
		CA	FINISHED
		EXTEND
		SU 	ONE
		EXTEND
		BZF	FINIS2		# IF FINISHED=1 NO NEED TO UPDATE
STILFLY2	CA	DSKYPHAS	# COMPLEMENT THE PHASE FLAG 
		OCT	40000		# COMPLEMENT
		TS	DSKYPHAS
		EXTEND
		BZMF	PHAS2		# IF NEG GOTO PHASE2
		CA	HEIGHT		
		TS	SUBJECT
		TC	EXTRDIGS
		TC	DSPREGX
		CA	SPEED
		TS	SUBJECT
		TC	EXTRDIGS
		TC	DSPREGY
		CA	HEIGHT
		EXTEND
		BZMF	FINIS1		# IF HEIGHT <=0	THEN SET FINISHED=1 AND EXIT
		CA	SPEED		# WE NEED TO CHECK THE SPEED
		AD	MAXSPD		# ADD 3M/S
		EXTEND 
		BZF	CLRVEL		# SPEED IS 0 -> CLEAR VEL LIGHT
		EXTEND
		BZMF	SETVEL		# SPEED IS < -3 -> SET VEL LIGHT
		TCF	CLRVEL		# BY DEFAULT WE CLEAR LIGHT
SETVEL		CA	VELON		# SPEED OUTSIDE LIMIT
		TCF	WRITEVEL		
CLRVEL		CA	VELOFF		# CLEAR VEL LIGHT
WRITEVEL	EXTEND
		WRITE	10		
		TCF	FINIS2
PHAS2		CA	FUEL		
		TS	SUBJECT
		TC	EXTRDIGS
		TC	DSPREGZ
		TC	DSPPROG	
		TCF 	FINIS2
FINIS1		CA	ONE
		TS	FINISHED	# TO SIGNAL WE LANDED
FINIS2		DXCH    ARUPT       	# Restore A, L, and Q, and exit the interrupt
		EXTEND
		QXCH    QRUPT
		RESUME 

#
# CALC SERVICING
#
T5RUPT		CAF	CALCUPDA	# SERVICES THE CALCULATION
		TS	TIME5
		CA	STARTED
		EXTEND
		BZF	NOTFLYN		# NOT STARTED YET
		CA	FINISHED	# CHECK FOR STILL FLYING
		EXTEND
		BZF	STILFLYN
		TCF	NOTFLYN
STILFLYN	TC	UPDASTAT
NOTFLYN		DXCH    ARUPT       # Restore A, L, and Q, and exit the interrupt
		EXTEND
		QXCH    QRUPT
		RESUME   
#
# KEYPAD SERVICING
#
KEYRUPT1    	EXTEND		       	# SERVICES KEYBOARD
		READ    15	        # Read the DSKY keycode input channel
		MASK    O37     	# Get rid of all but lowest 5 bits.
		TS      KEYBUF       	# save the keycode for later.	
		CA      NOKEY
		EXTEND
		SU      KEYBUF        	# Acc will now be zero if no key, non-zero otherwise
		EXTEND
		BZF     ENDKEYS		# no key was pressed so we dont change previous PWRLEVEL ###
		CA	KEYBUF
		EXTEND
		SU	ENTERKEY	# Enter key pressed ?
		EXTEND
		BZF	STARTING
		CA	KEYBUF
		EXTEND
		SU	RESETKEY	# reset key pressed ?
		EXTEND
		BZF	RSETPREP
		CA	KEYBUF
		EXTEND
		SU	SIXTEEN
		EXTEND
		BZF	ZEROBUTN	# if KEYBUF=16 then it was Zero button press
		CA	KEYBUF		# LOAD KEY AGAIN
		TCF	NOT0BUT2	# PROCEED TO NORMAL PWR KEY
RSETPREP	CA	ONE
		TS	RESET
		TCF	ENDKEYS
STARTING	CA	ONE
		TS	STARTED
		TCF	ENDKEYS
NOT0BUT2	CA	STARTED		# NEED TO CHECK IF STARTED ALREADY
		EXTEND
		BZF	ZEROBUTN	# NOT STARTED
		CA	KEYBUF
		TCF	NOT0BUTN
ZEROBUTN	CA	ZERO
NOT0BUTN	TS	PWRLEVEL
ENDKEYS		CA      NOKEY
		TS      KEYBUF        	# Mark keycode buffer as empty.		
		DXCH    ARUPT        # Restore A, L, and Q, and exit the interrupt
		EXTEND
		QXCH    QRUPT
		RESUME   	
  				
