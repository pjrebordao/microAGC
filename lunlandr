# START OF THE LOOP
ALLDONE     	CS      NEWJOB		# Tickle the Night Watchman

		CA	RESET		
		EXTEND
		BZF	GOAROUND	# NO RESET KEY PRESSED
		CA	ZERO		# IF RESET PRESSED, ZERO RESET FLAG AND RESTART
		TS	RESET
		TCF	RSETINIT
		
GOAROUND	TCF     ALLDONE  

# EXTRDIGS - Extracts 5 binary digits from a 15bit 1-complement integer initially in SUBJECT
# If negative we start by complementing it
# The digits will appear in DIGIT1..DIGIT5 - DIGIT1 being the left most
# Range is +/- 16383
EXTRDIGS	CS	NEWJOB
		CA	ZERO		# INIT ALL DIGITS TO ZERO
		TS	DIGIT1
		TS	DIGIT2
		TS	DIGIT3
		TS	DIGIT4
		TS	DIGIT5
		TS	DIGIT5BK
		CA	SUBJECT
		EXTEND
		BZF	REALSTRT	# IF ZERO PROCEED
		EXTEND
		BZMF	COMPLEMT	# ITS NEGATIVE SO WE HAVE TO COMPLEMENT
		TCF	REALSTRT
COMPLEMT	OCT	40000		# COMPLEMENT
		TS	SUBJECT		# SAVE IT		
		CA 	SUBJECT		
REALSTRT	EXTEND
		SU	TH10
		EXTEND
		BZF	EQGT10TH
		EXTEND
		BZMF	LT10TH		# DIGIT1 WILL BE ZERO BUT IT'S ALREADY ZERO SO WE CONTINUE					# SUBJECT WILL ALSO REMAIN UNCHANGED AS ITS LT 10000		
EQGT10TH	TS	SUBJECT
		CA	ONE
		TS	DIGIT1		
LT10TH		CA	TH1
		TS	COUNTER
SUB1TH		CA	SUBJECT
		EXTEND
		SU	COUNTER
		EXTEND
		BZF	EQ1TH
		EXTEND
		BZMF	LT1TH			
GT1TH		CA	COUNTER		# INCREASE CTR BY 1000
		AD	TH1
		TS	COUNTER
		EXTEND
		AUG	DIGIT2		# INCR DIGIT2 BY 1
		TCF	SUB1TH		# GO AROUND AGAIN
LT1TH		CA	COUNTER
		EXTEND
		SU	TH1
		TS	COUNTER
EQ1TH		NOOP
		
		CA	SUBJECT
		EXTEND
		SU	COUNTER
		TS	SUBJECT
		CA	HUNDRED
		TS	COUNTER
SUB1H		CA	SUBJECT
		EXTEND
		SU	COUNTER
		EXTEND
		BZF	EQ1H
		EXTEND
		BZMF	LT1H			
GT1H		CA	COUNTER		# INCREASE CTR BY 100
		AD	HUNDRED
		TS	COUNTER
		EXTEND
		AUG	DIGIT3		# INCR DIGIT3 BY 1
		TCF	SUB1H		# GO AROUND AGAIN
LT1H		CA	COUNTER
		EXTEND
		SU	HUNDRED
		TS	COUNTER
EQ1H		NOOP
		CA	SUBJECT
		EXTEND
		SU	COUNTER
		TS	SUBJECT
		CA	TEN
		TS	COUNTER	
SUB1T		CA	SUBJECT
		EXTEND
		SU	COUNTER
		EXTEND
		BZF	EQ1T
		EXTEND
		BZMF	LT1T			
GT1T		CA	COUNTER		# INCREASE CTR BY 10
		AD	TEN
		TS	COUNTER
		EXTEND
		AUG	DIGIT4		# INCR DIGIT4 BY 1		
		TCF	SUB1T		# GO AROUND AGAIN
LT1T		CA	COUNTER
		EXTEND
		SU	TEN
		TS	COUNTER
EQ1T		NOOP
		CA	SUBJECT
		EXTEND
		SU	COUNTER
		TS	DIGIT5
		TS	DIGIT5BK
THEEND		OCT	2		# RETURN
		
