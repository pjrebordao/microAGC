# UPDASTAT - Runs one update cycle for altitude, fuel and vertical speed
# Each cycle counts as 1 second elapsed
# FUEL should be loaded initially from FUEL0 
# After each run ONSURFAC must be tested. If =1 means we landed
UPDASTAT	CA	CASTATUS
		EXTEND
		WRITE	11			# TURN ON COMPACTY LIGHT
		EXTEND
		AUG	TIMECTR			# UPDATE/INCREASE THE TIME COUNTER BY 1
# FUEL CHECKS
		CA	PWRLEVEL
		EXTEND
		BZF	ZEROTHR			# IF THROTTLE=0 SAME AS EMPTY
		CA	FUEL			# LOAD FUEL AMOUNT
		EXTEND
		BZMF	ZEROFUEL		# IF EMPTY SKIP
		EXTEND
		SU	PWRLEVEL		# SUBTRACT SPENT FUEL
		TS	FUEL			# UPDATE FUEL COUNTER
# ACCEL CALC
		CA	PWRLEVEL
		AD	PWRLEVEL		# PWRLEVEL * 2
		EXTEND
		SU	MIDPWR			# SUBTRACT PREVIOUS QUOTIENT BY MIDPWR - THE RESULT CAN BE NEGATIVE
		TS	TGTACCEL		# THIS IS THE TARGETED ACCEL
		EXTEND
		SU	ACCEL			# WE COMPARE WITH THE CURRENT ACCEL
		EXTEND 
		BZF	SPEDCALC		# IF WE'RE THERE WE LEAVE IT AS IT IS
		EXTEND
		BZMF	SLOWIT			# WE NEED TO SLOWIT
		CA	ACCEL			# OTHERWISE, WE INCREASE ACCEL
		AD	ONE
		TS	ACCEL
		TCF	SPEDCALC
SLOWIT		CA	ACCEL
		EXTEND
		SU	ONE			# DECREASE ACCEL
		TS	ACCEL
		TCF	SPEDCALC
ZEROFUEL	CA	ZERO			# ZERO FUEL COUNTER AND PWRLEVEL
		TS	FUEL
		TS	PWRLEVEL
ZEROTHR		CA	GRAVITY
		TS	ACCEL			# WITH NO FUEL ACCEL IS FIXED AT SIM LUNAR GRAVITY
# STARTING SPEED CALC
SPEDCALC	CA	TIMECTR
		EXTEND
		SU	ONE
		EXTEND
		BZF	FRSTTIME		# FOR THE FIRST TIME THROUGH WE HAVE DIFFERENT CALCS
