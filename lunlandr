		CA	ONE
		TS	DSKYPHAS	# READY TO BE TOGGLED / COMPLEMENTED			
# CLEAR VERB / NOUN		
		CA	VERBBLNK
		EXTEND
		WRITE	10
		CA	NOUNBLNK
		EXTEND 
		WRITE	10		
# INIT DISPLAYS
		TC	DSPPROG
