void updateFlash(uint16_t val){
	if (val & DSKY_TEMP)	tft.pushImage(64, 37, 36, 17, TempOn); else tft.pushImage(64, 37, 36, 17, TempOff);	
	if (val & DSKY_KEY_REL)	tft.pushImage(25, 99, 36, 17, KeyRelOn); else tft.pushImage(25, 99, 36, 17, KeyRelOff);	
	if (val & DSKY_VN_FLASH) {
		// verb
		tft.fillRect(142, 82, 20, 14, vDEF_BGRD_COL);
		tft.setTextColor(TFT_GREEN);
		tft.setCursor(142, 82);
	  tft.print(curVerb1);
		tft.setCursor(152, 82);
	  tft.print(curVerb2);
		// noun
		tft.fillRect(195, 82, 20, 14, vDEF_BGRD_COL);
		tft.setTextColor(TFT_GREEN);
		tft.setCursor(195, 82);
	  tft.print(curNoun1);
		tft.setCursor(205, 82);
	  tft.print(curNoun2);		
	} else {
		// verb
		tft.fillRect(142, 82, 20, 14, vDEF_BGRD_COL);
		// noun
		tft.fillRect(195, 82, 20, 14, vDEF_BGRD_COL);		
	}
	if (val & DSKY_OPER_ERR) tft.pushImage(25, 120, 36, 17, OprErrOn); else tft.pushImage(25, 120, 36, 17, OprErrOff);
	if (val & DSKY_RESTART) tft.pushImage(64, 99, 36, 17, RestartOn); else tft.pushImage(64, 99, 36, 17, RestartOff);	
  if (val & DSKY_STBY) tft.pushImage(25, 79, 36, 17, StbyOn); else tft.pushImage(25, 79, 36, 17, StbyOff);	
	if (val & DSKYMASKPRIODISP) tft.pushImage(25, 140, 36, 17, PrioDispOn); else tft.pushImage(25, 140, 36, 17, PrioDispOff);
  if (val & DSKYMASKNODAP) tft.pushImage(25, 160, 36, 17, NoDapOn); else tft.pushImage(25, 160, 36, 17, NoDapOff);	
}


void updateDigits(uint16_t val){
	uint16_t row, col;
	bool splitRow = false;
	bool digit11 = false;
	bool VN = false;
	
	if (val == 0) return;
	dskyDig2 = dskyDigMapping[val & DSKYMASKDIGITS];
	dskyDig1 = dskyDigMapping[(val >> 5)& DSKYMASKDIGITS];
	row = col = 0;		// defaults 
	//showSign(146, 106, DSKYSIGNBLANK);
	//showSign(146, 133, DSKYSIGNBLANK);
	//showSign(146, 160, DSKYSIGNBLANK);

  switch (val & DSKYMASK1215){
    case DSKYMASKM1M2:
      row = 47;
      col = 195;    
      break;
    case DSKYMASKV1V2:
      row = 82;
      col = 142;
      VN = true;
      curVerb1 = dskyDig1;
      curVerb2 = dskyDig2;
      break;    
    case DSKYMASKN1N2:
      row = 82;
      col = 195;
      VN = true;    
      curNoun1 = dskyDig1;
      curNoun2 = dskyDig2;
      break;    
    case DSKYMASK11:
      row = 107;
      col = 155;
      digit11 = true;
      break; 
    case DSKYMASK1213:
      row = 107;
      col = 167;
      if (val & DSKYMASKSIGN) showSign(146, 106, DSKYSIGNPLUS); else showSign(146, 106, DSKYSIGNBLANK);
      break;    
    case DSKYMASK1415:
      row = 107;
      col = 192;
      if (val & DSKYMASKSIGN) showSign(146, 106, DSKYSIGNMINUS); else showSign(146, 106, DSKYSIGNBLANK);
      break;    
    case DSKYMASK2122:
      row = 134;
      col = 155;
      if (val & DSKYMASKSIGN) showSign(146, 133, DSKYSIGNPLUS); else showSign(146, 133, DSKYSIGNBLANK);
      break;    
    case DSKYMASK2324:
      row = 134;
      col = 179;
      if (val & DSKYMASKSIGN) showSign(146, 133, DSKYSIGNMINUS); else showSign(146, 133, DSKYSIGNBLANK);
      break;    
    case DSKYMASK2531:
      row = 134;
      col = 203;
      splitRow = true;
      break;    
    case DSKYMASK3233:
      row = 161;
      col = 167;
      if (val & DSKYMASKSIGN) showSign(146, 160, DSKYSIGNPLUS); else showSign(146, 160, DSKYSIGNBLANK);
      break;    
    case DSKYMASK3435:
      row = 161;
      col = 191;
      if (val & DSKYMASKSIGN) showSign(146, 160, DSKYSIGNMINUS); else showSign(146, 160, DSKYSIGNBLANK);
      break;   
    case DSKYMASKINDICATOR:
      updateLights(val);
      break;
  }

	if ((row != 0) && (col != 0)){		// Digit 1
		tft.fillRect(col, row, 12, 14, vDEF_BGRD_COL);
		tft.setCursor(col, row);
		tft.setTextColor(TFT_GREEN);
		if (digit11) tft.print(dskyDig2); else tft.print(dskyDig1);
  	if (splitRow){		// DSKYMASK2531
		  tft.fillRect(155, 161, 12, 14, vDEF_BGRD_COL);
  		tft.setCursor(155, 161);
			tft.setTextColor(TFT_GREEN);
		  tft.print(dskyDig2);
		} else {		
		  if (VN) {
				tft.fillRect(col+10, row, 12, 14, vDEF_BGRD_COL);
				tft.setCursor(col+10, row);
			} else {
				tft.fillRect(col+12, row, 12, 14, vDEF_BGRD_COL);
				tft.setCursor(col+12, row);
			}
			tft.setTextColor(TFT_GREEN);
	  	tft.print(dskyDig2);
		}
	}	
}


byte getACA(){
  delay(WAIT4ACA);
  if (digitalRead(ACA_INC) == LOW) return(ACA_INC);
  if (digitalRead(ACA_DEC) == LOW) return(ACA_DEC);
  if (digitalRead(ACA_T00) == LOW) return(ACA_T00);
  if (digitalRead(ACA_T09) == LOW) return(ACA_T09);
  return(0);    
}


boolean processDsky(){
  uint16_t val, ch, key;
	int recvCtr;

	while(true){
		if (recvCtr == DSKYRECVRATE) recvCtr = 0; else recvCtr++;
		
		if (queue_try_remove(&a2d, &Agc2Dsky)){
// process display updates if any
			ch = Agc2Dsky.ch;
			val = Agc2Dsky.val;
			switch(ch){
      case (010):
				updateDigits(val);
				break;
      case (011): 
				updateIndicators(val);    
        break;
      case (0163): 
				updateFlash(val);    
        break;
		  default:
        break;
			}
		}
		
// we process key strokes and ACA if any and the time is right
	  if (recvCtr == DSKYRECVRATE){
      oldThrottle = throttle;
      switch(getACA()){
        case ACA_INC:
          if (throttle < 9) throttle++;
          break;
        case ACA_DEC:
          if (throttle > 0) throttle--;
          break;
        case ACA_T00:
          throttle = 0;
          break;          
        case ACA_T09:
          throttle = 9;                    
          break;          
      }
      
      vDEF_BGRD_COL = TFT_WHITE; 
		  key = msysGet(20);
      vDEF_BGRD_COL = TFT_BLACK;
      
			if (key == 19) return(false); 	// leave DSKY
     
		  if ((key != MSYS_NOCHOICE) || (oldThrottle != throttle)){   // a key was pressed or ACA has moved
				if (dskyKeyMapping[key] == 99){	// PRO keypress
					Dsky2Agc.ch = 032;
					Dsky2Agc.val = DSKYPROCEED;			
				} else {
					Dsky2Agc.ch = 015;
          if (oldThrottle != throttle)    // ACA movement
            Dsky2Agc.val = throttle;
          else
					  Dsky2Agc.val = dskyKeyMapping[key];
				}
				queue_add_blocking(&d2a, &Dsky2Agc);
			}	
		}
	}
	return(true);
}


