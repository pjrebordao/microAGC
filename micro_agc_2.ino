        }
        break;
      case (2):   // sel
        fileName = fileList[curSel];
        root.close();
        return (true);
      case (3):   // dn
        if (curSel == (fileCtr-1)) curSel = 0; else curSel++;
        tft.setFreeFont(FSS9);
        for (int i = 0; i < fileCtr; i++) {
          if (i == curSel) tft.setTextColor(vDEF_FGRD_COL, vDEF_BGRD_COL); else tft.setTextColor(TFT_RED, vDEF_BGRD_COL);
          tft.setCursor(2, 50 + (i * LISTLINEHEIGHT));
          tft.print(fileList[i] + " ");
        }
        break;
      case (4):   // back
      case (MSYS_NOCHOICE):  // no choice
        root.close();
        return (false);
    }
  }
}


