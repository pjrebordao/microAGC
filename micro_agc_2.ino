// init for DSKY core
void setup(){
  // General inits
  // wait until on-off button is released, before attaching interrupt
  while (digitalRead(OFF_BUTTON) == HIGH){}
  attachInterrupt(digitalPinToInterrupt(OFF_BUTTON), killMe, CHANGE);

  // screen init
  tft.init();
  delay(INIT_DELAY);                       // enough time for TFT to wake-up
  tft.setTextWrap(true, true);
	tft.setTextDatum(TL_DATUM);
	tft.setRotation(2);
  tft.fillScreen(vDEF_BGRD_COL); 

  // init touch
  Wire.setSDA(16);
  Wire.setSCL(17);
  Wire.begin();
  delay(INIT_DELAY);
  if (!ts.begin(TOUCH_SENSE)) tft.println("Touch not found!");

  // init card reader
  SPI.setRX(_MISO);
  SPI.setTX(_MOSI);
  SPI.setSCK(_SCK);
  delay(INIT_DELAY);
  if (!SD.begin(_CS)) tft.println("Card not found!");

  // pins
  pinMode(ACA_INC, INPUT_PULLUP);
  pinMode(ACA_DEC, INPUT_PULLUP);
  pinMode(ACA_T00, INPUT_PULLUP);
  pinMode(ACA_T09, INPUT_PULLUP);
  
	#ifdef DEBUG
	Serial.begin(115200);
	while (!Serial){};
	#endif
	
	// multicore queues
	queue_init_with_spinlock(&a2d, 4, 120, 1);
	queue_init_with_spinlock(&d2a, 4, 120, 2);

  ipc_core = IPCSTOP;	
}    


void loop1(){
  if(ipc_core == IPCRUN) {
		agc_engine (&State);
		delayMicroseconds(8);
	}
}


void loop(){
	if (selFileFromCard()){
		loadCore();
		initAgc();
		initDsky();
	} else killMe();
	
   ipc_core = IPCRUN;  
	 while (processDsky()){};
   ipc_core = IPCSTOP;
}
